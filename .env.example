# ──────────────────────────────────────────────────────────────
# TRON V1 — copy this file to .env.local and fill it in.
# Nothing here ever leaves your server.
# ──────────────────────────────────────────────────────────────

# The one passphrase that unlocks TRON. Required — TRON will not start without it.
# Make it long. This is the only thing between your data and anyone on the network.
TRON_PASSPHRASE=change-me-to-something-long-and-private

# Where SQLite keeps everything. Relative paths resolve against the project root.
TRON_DB_PATH=./data/tron.db

# Your local llama.cpp server. Leave as-is if you run it on the default port.
TRON_LLM_URL=http://127.0.0.1:8080
TRON_LLM_MODEL=Qwen3-1.7B-Q4_K_M
TRON_LLM_TIMEOUT_MS=120000

# Shown on the home screen.
TRON_OWNER_NAME=Owner

# Origins allowed to invoke server actions — comma separated, no trailing slash.
# Add your Redmi's LAN address and, later, your tunnel hostname.
# e.g. http://192.168.1.42:3000,https://tron.your-tailnet.ts.net
TRON_ALLOWED_ORIGINS=

# Set to true only when TRON is served over HTTPS end to end.
TRON_COOKIE_SECURE=false

# How often the server checks SQLite for changes to push to open screens (ms).
TRON_EVENT_POLL_MS=700
